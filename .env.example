# Copy to .env; never commit the actual .env file.
# Generate token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
UCAP_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
# Default is localhost-only. For Windows clients on a private LAN, use
# the Linux host's specific LAN IPv4 address, never 0.0.0.0 publicly.
UCAP_BIND=127.0.0.1
