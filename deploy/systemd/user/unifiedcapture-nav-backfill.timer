[Unit]
Description=Schedule finite NAV-10 candidate backfill with a pause after each run
Documentation=https://github.com/n0gr1p/UnifiedCapture/issues/14

[Timer]
OnActiveSec=5min
OnUnitInactiveSec=15min
AccuracySec=1min
Unit=unifiedcapture-nav-backfill.service
Persistent=false

[Install]
WantedBy=timers.target
